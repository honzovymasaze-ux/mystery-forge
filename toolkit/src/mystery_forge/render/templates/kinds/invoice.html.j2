{% from "macros.html.j2" import page_label, field_row %}
<article class="prop prop-full invoice">
  <header class="invoice-head">
    <div>
      <p class="invoice-issuer">{{ f.get("issuer") or "" }}</p>
      {% if f.get("address") %}<p class="invoice-address">{{ f.get("address") }}</p>{% endif %}
    </div>
    <div class="invoice-word">
      <p class="invoice-kind">{{ t("word_invoice") }}</p>
      {% if f.get("number") %}<p class="invoice-number">{{ t("field_number") }} {{ f.get("number") }}</p>{% endif %}
    </div>
  </header>
  {% if page.page_number == 1 %}
  <div class="invoice-fields">
    {{ field_row(t, f, "recipient") }}
    {{ field_row(t, f, "date") }}
    {{ field_row(t, f, "due_date") }}
  </div>
  {% endif %}
  <div class="doc-body invoice-body">{{ page.html }}</div>
  {% if f.get("total") %}<p class="invoice-total"><span>{{ t("field_total") }}</span><span>{{ f.get("total") }}</span></p>{% endif %}
  {{ page_label(t, page) }}
</article>
