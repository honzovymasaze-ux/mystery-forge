<div class="safe chapters-page">
  <header class="sheet-header">
    <p class="sheet-kicker">{{ content.narrator }}</p>
    <h1>{{ t("chapters_title") }}</h1>
  </header>
  {% if content.first %}<p class="sheet-intro">{{ t("chapters_intro") }}</p>{% endif %}
  <div class="chapters">
    {% for block in content.blocks %}
    {% if block.heading %}<h2 class="chapter-title">{{ block.text }}</h2>{% else %}<p class="chapter-paragraph">{{ block.text }}</p>{% endif %}
    {% endfor %}
  </div>
</div>
